  "tasks": [
    {
      "id": "monthly_refund_breakdown",
      "category": "complex_sql",
      "turns": [
        {
          "question": "For each year-month, report these columns in order: month, gross positive revenue, refund revenue as a negative amount, and net revenue. Include zero-revenue rows and sort chronologically.",
          "expected": {
            "kind": "sql",
            "columns": [
              "InvoiceMonth",
              "gross_revenue",
              "refund_revenue",
              "net_revenue"
            ],
            "rows": [
              [
                "2024-11",
                142.0,
                -15.0,
                127.0
              ],
              [
                "2024-12",
                102.0,
                -12.0,
                90.0
              ],
              [
                "2025-01",
                108.0,
                -12.0,
                96.0
              ],
              [
                "2025-02",
                92.0,
                -8.0,
                84.0
              ],
              [
                "2025-03",
                121.0,
                -15.0,
                106.0
              ]
            ]
          },
          "oracle_sql": "SELECT InvoiceMonth,SUM(CASE WHEN Revenue>0 THEN Revenue ELSE 0 END) AS gross_revenue,SUM(CASE WHEN Revenue<0 THEN Revenue ELSE 0 END) AS refund_revenue,SUM(Revenue) AS net_revenue FROM transactions GROUP BY InvoiceMonth ORDER BY InvoiceMonth"
        }
      ]
    },
    {
      "id": "running_monthly_total",
      "category": "complex_sql",
      "turns": [
        {
          "question": "Show month, monthly net revenue, and cumulative net revenue over all months, sorted chronologically. Include refunds. Return those three columns in that order.",
          "expected": {
            "kind": "sql",
            "columns": [
              "InvoiceMonth",
              "net_revenue",
              "cumulative_revenue"
            ],
            "rows": [
              [
                "2024-11",
                127.0,
                127.0
              ],
              [
                "2024-12",
                90.0,
                217.0
              ],
              [
                "2025-01",
                96.0,
                313.0
              ],
              [
                "2025-02",
                84.0,
                397.0
              ],
              [
                "2025-03",
                106.0,
                503.0
              ]
            ]
          },
          "oracle_sql": "WITH m AS (SELECT InvoiceMonth,SUM(Revenue) AS net_revenue FROM transactions GROUP BY InvoiceMonth) SELECT InvoiceMonth,net_revenue,SUM(net_revenue) OVER (ORDER BY InvoiceMonth ROWS UNBOUNDED PRECEDING) AS cumulative_revenue FROM m ORDER BY InvoiceMonth"
        }
      ]
    },
    {
      "id": "country_revenue_share",
      "category": "complex_sql",
      "turns": [
        {
          "question": "For every country, show country, net revenue, and its share of overall net revenue as a percentage rounded to two decimals. Return those three columns in that order, sorted by net revenue descending. Include refunds.",
          "expected": {
            "kind": "sql",
            "columns": [
              "Country",
              "net_revenue",
              "share_pct"
            ],
            "rows": [
              [
                "US",
                147.0,
                29.22
              ],
              [
                "UK",
                105.0,
                20.87
              ],
              [
                "JP",
                94.0,
                18.69
              ],
              [
                "FR",
                88.0,
                17.5
              ],
              [
                "DE",
                69.0,
                13.72
              ]
            ]
          },
          "oracle_sql": "WITH c AS (SELECT Country,SUM(Revenue) AS net_revenue FROM transactions GROUP BY Country) SELECT Country,net_revenue,ROUND(100.0*net_revenue/SUM(net_revenue) OVER (),2) AS share_pct FROM c ORDER BY net_revenue DESC,Country"
        }
      ]
    },
