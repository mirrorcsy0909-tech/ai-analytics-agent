OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=openai:gpt-5.6
OPENAI_REASONING_EFFORT=medium

# Optional. Off by default; cloud traces hide inputs, outputs and error details.
ANALYTICS_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=analytics-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set only for a key scoped to multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Optional HTTP API access token for clients of your own service.
# Leave empty for loopback-only development. This is separate from model/provider keys.
ANALYTICS_API_TOKEN=
ANALYTICS_API_MAX_ACTIVE=2
